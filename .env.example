# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CHUbot
APP_VERSION=1.0.0
APP_ENV=development          # development | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Base de données (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@localhost:5432/chubot

# ── LLM — Ollama local (aucune clé API requise) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:9b
# Modèles alternatifs : llama3.2:3b, mistral:7b, gemma2:9b

# ── Embeddings — Ollama local ──────────────────────────────────────────────────
# Prérequis : ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5

# ── Index vectoriel ────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./data/indexes
