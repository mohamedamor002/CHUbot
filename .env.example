# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CHUbot
APP_VERSION=0.1.0
APP_ENV=development          # development | staging | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Développement local
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@localhost:5432/chubot
# Docker (remplacé automatiquement par docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chubot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Docker PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chubot

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
# Développement local
OLLAMA_BASE_URL=http://localhost:11434
# Docker (Windows/Mac) — décommenter si vous utilisez Docker
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Docker (Linux) — décommenter si vous utilisez Docker sur Linux
# OLLAMA_BASE_URL=http://172.17.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Embeddings ────────────────────────────────────────────────────────────────
# Modèle d'embeddings via Ollama — lancer d'abord : ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5

# ── Vector Store ──────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma      # chroma | qdrant | faiss
VECTOR_STORE_PATH=./data/indexes
# QDRANT_URL=http://localhost:6333  # only if VECTOR_STORE_TYPE=qdrant

# ── Celery Workers ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
