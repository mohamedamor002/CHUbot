# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CHUbot
APP_VERSION=0.1.0
APP_ENV=development          # development | staging | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:2002@localhost:5432/chubot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=c57d156c25c1192f5a9bcd262e10d84f5a71b901ea16089deee1c77784ca41ef3
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://172.17.0.1:11434  # Linux Docker only

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest    

# ── Embeddings ────────────────────────────────────────────────────────────────
# Modèle d'embeddings via Ollama — lancer d'abord : ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=3

# ── Vector Store ──────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma      # chroma | qdrant | faiss
VECTOR_STORE_PATH=./data/indexes
# QDRANT_URL=http://localhost:6333  # only if VECTOR_STORE_TYPE=qdrant

